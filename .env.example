# Copy to .env.local and fill in. Never commit real values. One file for both apps.
# Free key: https://aistudio.google.com/apikey  (TallyBack reads bills; Review Scout writes summaries)
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash)
GEMINI_MODEL=
# Optional backup when Gemini fails or is busy. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Database: Neon Postgres (Vercel → Storage → Neon). Each app creates its own tables on first use.
# Without it, data goes to .data/db.json (TallyBack) and .data/reviewscout.json (Review Scout) locally.
DATABASE_URL=
# Optional, TallyBack: private photo storage in Vercel Blob. Without it, photos are kept privately in the database.
BLOB_READ_WRITE_TOKEN=

# Sign-in (Auth/): passwordless email codes and links, allow-listed addresses only.
# Random secret for signing sessions: run `openssl rand -base64 32`. Required in production.
BETTER_AUTH_SECRET=
# The site's public address, used in sign-in links: https://tinkeryard.dev (http://localhost:3000 locally)
BETTER_AUTH_URL=
# Resend (https://resend.com) sends the emails. Without it, in development, emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="Tinkeryard <login@tinkeryard.dev>"
# Admins: comma-separated emails. They get every app and the admin dashboard at /admin, where they add
# everyone else and choose their role and apps. They can't be changed or locked out from the dashboard.
ADMIN_EMAILS=
# Optional, the original invite list: these people get every app as Members until an admin edits them.
ALLOWED_EMAILS=
