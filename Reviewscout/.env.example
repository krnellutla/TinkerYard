# Copy to .env.local and fill in. Never commit real values.
# Free key: https://aistudio.google.com/apikey  (with no AI key, the app lists what it collected)
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash)
GEMINI_MODEL=
# Optional backup when Gemini fails or is busy. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Database: Neon Postgres. The scout_searches table is created automatically.
# Without it, searches go to .data/db.json locally.
DATABASE_URL=
